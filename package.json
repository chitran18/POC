{
  "name": "orangehrm-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Senior QA Automation technical test framework for OrangeHRM employee lifecycle automation.",
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "bddgen && playwright test",
    "test:e2e": "bddgen && playwright test --grep @e2e",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:headed": "bddgen && playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.0",
    "playwright-bdd": "^8.1.0",
    "typescript": "^5.5.4"
  }
}
